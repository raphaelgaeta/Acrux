<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Acrux.Core\Acrux.Core.csproj" />
  </ItemGroup>

  <!-- The managed Polars.NET comes from Acrux.Core, but the native library
       is one package per platform: the one of the RID being published
       (dotnet publish -r linux-arm64), or else the build machine's, by OS and
       architecture. Polars.NET has no win-arm64 package. -->
  <PropertyGroup>
    <PolarsNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</PolarsNativeRid>
    <PolarsNativeArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</PolarsNativeArch>
    <PolarsNativeRid Condition="'$(PolarsNativeRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-$(PolarsNativeArch)</PolarsNativeRid>
    <PolarsNativeRid Condition="'$(PolarsNativeRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-$(PolarsNativeArch)</PolarsNativeRid>
    <PolarsNativeRid Condition="'$(PolarsNativeRid)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx-$(PolarsNativeArch)</PolarsNativeRid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polars.NET.Native.$(PolarsNativeRid)" Version="1.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
