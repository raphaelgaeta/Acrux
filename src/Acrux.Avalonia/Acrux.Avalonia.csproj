<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop app, on Avalonia, for Windows and Linux (desenho aprovado em
       2026-11-15). It took the WinForms app's place on 2026-11-16: the same
       executable name, the installer and the release point here. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Acrux</AssemblyName>
    <RootNamespace>Acrux</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets/acrux.ico</ApplicationIcon>
    <!-- single file (the release's zip): the native libraries go inside, and the
         C# terminal needs everything extracted to disk, since Roslyn resolves
         references through Assembly.Location, empty in a pure single file
         (dotnet/roslyn#50719). Never trim: Roslyn scripting needs the metadata. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- desktop GC tuning: workstation, concurrent, DATAS (CLAUDE.md) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Acrux.Core/Acrux.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <!-- the D-Bus client Avalonia itself uses on Linux (Avalonia.FreeDesktop): the
         same version, for the portal's "contrast" key that Avalonia doesn't read -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- the windows' icon; ApplicationIcon only marks the .exe -->
    <AvaloniaResource Include="Assets/acrux.ico" />
  </ItemGroup>

  <!-- Polars' native library, as the CLI picks it: the publish RID, or the
       build machine's. Polars.NET has no win-arm64 package. -->
  <PropertyGroup>
    <PolarsNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</PolarsNativeRid>
    <PolarsNativeArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</PolarsNativeArch>
    <PolarsNativeRid Condition="'$(PolarsNativeRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-$(PolarsNativeArch)</PolarsNativeRid>
    <PolarsNativeRid Condition="'$(PolarsNativeRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-$(PolarsNativeArch)</PolarsNativeRid>
    <PolarsNativeRid Condition="'$(PolarsNativeRid)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx-$(PolarsNativeArch)</PolarsNativeRid>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Polars.NET.Native.$(PolarsNativeRid)" Version="1.0.1" />
  </ItemGroup>
</Project>
