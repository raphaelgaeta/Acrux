<?xml version="1.0" encoding="UTF-8"?>
<!-- The parquet type, registered with IANA in 2024 but missing from
     shared-mime-info: by the extension, and by the "PAR1" a parquet file starts with. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.apache.parquet">
    <comment>Apache Parquet file</comment>
    <glob pattern="*.parquet"/>
    <magic priority="50">
      <match type="string" offset="0" value="PAR1"/>
    </magic>
  </mime-type>
</mime-info>
